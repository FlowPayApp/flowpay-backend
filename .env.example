# PostgreSQL (URI). Supabase: añadir sslmode=require (y usar host/pooler del panel).
FLOWPAY_DSN=postgres://flowpay:flowpay@127.0.0.1:5432/flowpay?sslmode=disable
FLOWPAY_ADDR=:8080

# Mismo secreto que flowpay-sso (mín. 16 caracteres). Si está vacío, el API no exige Bearer (solo modo dev).
# FLOWPAY_JWT_SECRET=cambia-esto-mismo-en-sso-y-backend-32chars
# Producción: 24h. Para ver logs seguidos en demo: 1m
FLOWPAY_REMINDER_INTERVAL=24h

# --- Correo (SMTP). Ej. Gmail: smtp.gmail.com:587 + "contraseña de aplicación"
# Si falta alguno, solo se hace log mock.
FLOWPAY_SMTP_HOST=
FLOWPAY_SMTP_PORT=587
FLOWPAY_SMTP_USER=
FLOWPAY_SMTP_PASSWORD=
FLOWPAY_SMTP_FROM=
# Opcional: todos los correos van a tu bandeja (pruebas sin spamear clientes)
FLOWPAY_EMAIL_OVERRIDE=

# --- WhatsApp vía Twilio (no usa tu WhatsApp personal directamente; Twilio envía al número destino)
# Cuenta: https://www.twilio.com — en trial el destino debe estar verificado.
FLOWPAY_TWILIO_ACCOUNT_SID=
FLOWPAY_TWILIO_AUTH_TOKEN=
# Ej. sandbox: whatsapp:+14155238886
FLOWPAY_TWILIO_WHATSAPP_FROM=
# Opcional: siempre enviar a tu número en formato +56912345678 o whatsapp:+569...
FLOWPAY_WHATSAPP_OVERRIDE=
# 1/true: validar X-Twilio-Signature en POST /api/webhooks/twilio/whatsapp (requiere URL pública igual a la de Twilio)
FLOWPAY_TWILIO_VALIDATE_WEBHOOK=

# URL pública HTTPS del API (sin barra final). Twilio descarga adjuntos desde aquí; en local usa ngrok.
# Ej: https://abc123.ngrok.io
FLOWPAY_PUBLIC_BASE_URL=

# Carpeta donde guardar PDFs/imágenes subidas (relativa al directorio del servidor)
FLOWPAY_UPLOAD_DIR=data/uploads

# --- Correo (SMTP). Gmail: smtp.gmail.com, puerto 587, usuario = tu correo, contraseña = "contraseña de aplicación"
# FLOWPAY_SMTP_HOST=smtp.gmail.com
# FLOWPAY_SMTP_PORT=587
# FLOWPAY_SMTP_USER=tu@gmail.com
# FLOWPAY_SMTP_PASSWORD=xxxx
# FLOWPAY_SMTP_FROM="FlowPay <tu@gmail.com>"
# Opcional: todos los correos van a esta bandeja (pruebas sin tocar emails de clientes en BD)
# FLOWPAY_EMAIL_OVERRIDE=tu@gmail.com

# --- WhatsApp vía Twilio (no uses tu WhatsApp personal directo; Twilio te da un número/remitente de prueba)
# FLOWPAY_TWILIO_ACCOUNT_SID=ACxxxxxxxx
# FLOWPAY_TWILIO_AUTH_TOKEN=xxxxxxxx
# FLOWPAY_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Opcional: forzar destino a tu móvil en formato internacional sin prefijo whatsapp: (ej. +56912345678)
# FLOWPAY_WHATSAPP_OVERRIDE=+56912345678
