FLOWPAY_DSN=postgres://flowpay:flowpay@127.0.0.1:5432/flowpay?sslmode=disable
FLOWPAY_ADDR=:8080
FLOWPAY_JWT_SECRET=
# Recordatorios automáticos: una vez al día a esta hora (HH:MM) en la zona indicada.
FLOWPAY_REMINDER_TIME=10:00
FLOWPAY_TIMEZONE=America/Santiago

# Respaldo si una empresa aún no tiene buzón propio en el panel.
FLOWPAY_SMTP_HOST=
FLOWPAY_SMTP_PORT=587
FLOWPAY_SMTP_USER=
FLOWPAY_SMTP_PASSWORD=
FLOWPAY_SMTP_FROM=
FLOWPAY_EMAIL_OVERRIDE=

FLOWPAY_TWILIO_ACCOUNT_SID=
FLOWPAY_TWILIO_AUTH_TOKEN=
# Respaldo si la empresa aún no tiene un WhatsApp Business asignado en el panel.
FLOWPAY_TWILIO_WHATSAPP_FROM=
# Plantillas Utility (ContentSid). Vacío usa las de cobro_* ya creadas en Twilio.
FLOWPAY_TWILIO_TEMPLATE_APPROACHING=
FLOWPAY_TWILIO_TEMPLATE_DUE_TODAY=
FLOWPAY_TWILIO_TEMPLATE_OVERDUE=
FLOWPAY_TWILIO_TEMPLATE_FOLLOWUP=
FLOWPAY_WHATSAPP_OVERRIDE=
FLOWPAY_TWILIO_VALIDATE_WEBHOOK=

FLOWPAY_PUBLIC_BASE_URL=
# Origen público del frontend. El WhatsApp lleva https://esta-url/pay/{token} de la sucursal.
FLOWPAY_APP_PUBLIC_URL=

FLOWPAY_UPLOAD_DIR=data/uploads
